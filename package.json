{
  "name": "pgconn-doctor",
  "version": "0.0.1-pre",
  "description": "Postgres connection pool health diagnostic CLI with platform-aware recommendations (RDS, Aurora, Supabase, Neon, Cloud SQL, Azure).",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pgconn-doctor": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "connection-pool",
    "diagnostics",
    "cli",
    "rds",
    "aurora",
    "supabase",
    "neon",
    "cloud-sql",
    "azure",
    "node",
    "devops",
    "database"
  ],
  "author": "Naveen Reddy Devireddy <naveenreddydevireddy2@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/naveenreddy-devireddy/pgconn-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/naveenreddy-devireddy/pgconn-doctor/issues"
  },
  "homepage": "https://github.com/naveenreddy-devireddy/pgconn-doctor#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
